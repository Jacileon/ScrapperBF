# ============================================================
# Veille BF — SaaS — variables d'environnement (exemple)
# Copiez en .env (ou injectez via le service systemd) et adaptez.
# Aucune dépendance Python supplémentaire n'est requise : l'auth et les
# jetons utilisent la bibliothèque standard.
# ============================================================

# --- Sécurité (OBLIGATOIRE en production) ---
# Générez une valeur longue et aléatoire, ex :  python -c "import secrets;print(secrets.token_urlsafe(48))"
VEILLEBF_JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
VEILLEBF_JWT_TTL=604800          # durée de session en secondes (7 jours)

# --- Cookies ---
VEILLEBF_COOKIE_SECURE=0         # 1 en production (HTTPS obligatoire)
VEILLEBF_COOKIE_SAMESITE=lax

# --- URL publique & CORS ---
VEILLEBF_PUBLIC_URL=http://127.0.0.1:8000
VEILLEBF_CORS_ORIGINS=http://127.0.0.1:8000   # séparez par des virgules si plusieurs

# --- Base de données ---
# VEILLEBF_DB=/opt/veillebf/marches_publics_burkina.db

# --- Paiement ---
# sandbox  : simulation (aucun paiement réel) — défaut
# manual   : activation manuelle par un administrateur
# cinetpay / ligdicash : à implémenter dans backend/payments/ puis renseigner les clés
VEILLEBF_PAYMENT_PROVIDER=sandbox

# Clés de l'agrégateur (à renseigner quand vous aurez un compte marchand)
VEILLEBF_PROVIDER_API_KEY=
VEILLEBF_PROVIDER_SITE_ID=
VEILLEBF_PROVIDER_SECRET=
